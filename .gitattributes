# 统一换行符：源码用 LF，Windows 批处理保留 CRLF（否则 cmd 可能出错）
* text=auto

*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.txt  text eol=lf
*.bat  text eol=crlf

# 图片按二进制处理，别做任何换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
