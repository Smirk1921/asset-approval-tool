sets.d/


# ---- 本地测试用的一次性目录 ----
_test/
/tmp/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 内部工作文档（含具体项目信息，不发布）----
